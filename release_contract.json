  "breaking_changes": [
    {
      "id": "manifest-version-required",
      "phase": 143,
      "description": "El manifiesto declara manifest_version; los manifiestos anteriores se migran y sus aprobaciones quedan obsoletas.",
      "migration": "scripts/migrate_manifest.py"
    },
    {
      "id": "glossary-approved-at-declared",
      "phase": 30,
      "description": "El glosario declara approved_at, que approve_pilot.py escribe al congelarlo.",
      "migration": "scripts/approve_pilot.py"
    },
    {
      "id": "profile-corpus-required",
      "phase": 150,
      "description": "Un módulo opcional con enabled:true exige corpus_ref y justification. Un perfil que hoy los activa sin declararlos no valida contra profile.schema.json 1.1.0. Los perfiles de ejecuciones ya terminadas no se corrigen: su hash está anclado en el manifiesto y tocarlo invalidaría su aprobación (INV-13); su activación inmotivada queda registrada en evals/cases/<módulo>.md.",
      "migration": "scripts/migrate_profile.py"
    },
    {
      "id": "manifest-approval-hashes-declared",
      "phase": 124,
      "description": "El esquema de manifiesto acepta target_glossary_hash, target_anchor_hash, target_profile_hash y superseded_by en cada aprobación, que approval_freshness.py ya leía y que el esquema rechazaba.",
      "migration": null
    },
    {
      "id": "glossary-provenance-declared",
      "phase": 96,
      "description": "El esquema de glosario acepta el bloque provenance que term_provenance.py ya escribía en cada entrada.",
      "migration": null
    }
  ],
  "migrations": [
